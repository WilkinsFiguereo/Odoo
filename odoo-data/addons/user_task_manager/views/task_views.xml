<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista tipo formulario -->
    <record id="view_task_form" model="ir.ui.view">
        <field name="name">user.task.form</field>
        <field name="model">user.task</field>
        <field name="arch" type="xml">
            <form string="Tarea">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="priority"/>
                        <field name="state"/>
                        <field name="deadline"/>
                        <field name="user_id" readonly="1"/>
                        <field name="is_done" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista tipo Kanban -->
    <record id="view_user_task_kanban" model="ir.ui.view">
    <field name="name">user.task.kanban</field>
    <field name="model">user.task</field>
    <field name="arch" type="xml">
        <kanban default_group_by="state" class="o_kanban_small_column">
            <field name="name"/>
            <field name="priority"/>
            <field name="state"/>
            <field name="deadline"/>
            <field name="is_done"/>
            <field name="user_id"/>
            <templates>
                <!-- Kanban Box -->


                <t t-name="kanban-box">
                    <t t-if="record.priority and record.priority.raw_value">
                        <div t-attf-class="'oe_kanban_card user_task_kanban oe_kanban_global_click priority_'+ record.priority.raw_value">
                            <t t-call="user_task_manager.kanban_content"/>
                        </div>
                    </t>
                    <t t-if="!(record.priority and record.priority.raw_value)">
                        <div t-attf-class="'oe_kanban_card user_task_kanban oe_kanban_global_click priority_0'">
                            <t t-call="user_task_manager.kanban_content"/>
                        </div>
                    </t>
                </t>

                <!-- Plantilla de contenido -->
                <t t-name="user_task_manager.kanban_content">
                    <div class="o_kanban_details">
                        <strong><field name="name"/></strong>
                        <div>
                            <span><strong>Descripcion: </strong><field name="description"/></span>
                        </div>
                        <div>
                            <span><strong>Prioridad: </strong><field name="priority"/></span>
                        </div>
                        <div>
                            <span><strong>Estado: </strong><field name="state"/></span>
                        </div>
                        <div>
                            <i class='fa fa-calender'/>
                            <span><strong>Fecha Límite: </strong><field name="deadline"/></span>
                        </div>
                        <div>
                            <span><strong>Completada: </strong><field name="is_done"/></span>
                        </div>
                    </div>

                    <div class="oe_kanban_footer d-flex justify-content-between align-items-center">
                        <span class="o_kanban_record_creator">
                            <i class='fa fa-user'/>
                            <strong>Asignada a: </strong>
                            <field name="user_id"/>
                        </span>

                        <t t-if='record.priority and record.priority.raw_value'>
                            <span class="badge badge-primary" t-attf-class="task-state-badge state-#(record.state.raw_value)">
                                <t t-esc="record.state.value"/>
                            </span>
                        </t>
                    </div>

                    <t t-if="record.is_done and record.is_done.raw_value">
                        <div class="o_kanban_badge o_kanban_bottom_right">
                            <i class="fa fa-check-circle task-done" aria-hidden="true" title="Tarea Completada"/>
                        </div>
                        
                    </t>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <!-- Vista tipo lista -->
    <record id="view_user_task_list" model="ir.ui.view">
        <field name="name">user.task.list</field>
        <field name="model">user.task</field>
        <field name="arch" type="xml">
            <list string="Tareas">
                <field name="name"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="deadline"/>
                <field name="is_done"/>
            </list>
        </field>
    </record>

    <!-- Acción para abrir la vista -->
    <record id="acction_user_task" model="ir.actions.act_window">
        <field name="name">Mis tareas</field>
        <field name="res_model">user.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <h2>Gestiona tus tareas</h2>
            <p>Crea y administra tus tareas personales desde esta vista.</p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_user_task_root" name="Gestor de Tareas" sequence="10"/>
    <menuitem id="menu_user_task" name="Mis Tareas" parent="menu_user_task_root" action="acction_user_task" sequence="20"/>

</odoo>
